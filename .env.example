# Address of your deployed InventoryFactory contract on Sepolia
VITE_FACTORY_CONTRACT_ADDRESS=0xYourDeployedFactoryAddressHere

# Sepolia chain id (11155111 in decimal, 0xaa36a7 in hex)
VITE_SEPOLIA_CHAIN_ID=11155111

# Optional: public RPC endpoint used for read-only calls when MetaMask isn't connected
# and for building the "Add Sepolia Network" request. Get a free one from Infura/Alchemy.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Pexels API key for fetching real product images
# Get a free key at https://www.pexels.com/api/ (200 requests/hour)
VITE_PEXELS_API_KEY=
